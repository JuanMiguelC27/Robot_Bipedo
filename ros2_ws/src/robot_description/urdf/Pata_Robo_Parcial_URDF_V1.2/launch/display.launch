<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find Pata_Robo_Parcial_URDF_V1.2)/urdf/Pata_Robo_Parcial_URDF_V1.2.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find Pata_Robo_Parcial_URDF_V1.2)/urdf.rviz" />
</launch>