<?xml version="1.0"?>
<robot name="biped_leg" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materiales -->
  <material name="base_metal">
    <color rgba="0.25 0.28 0.32 1.0"/>
  </material>
  <material name="link_blue">
    <color rgba="0.20 0.45 0.85 1.0"/>
  </material>
  <material name="joint_orange">
    <color rgba="0.95 0.55 0.15 1.0"/>
  </material>
  <material name="foot_grey">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>

  <!-- Eslabon raiz: base del robot, en el origen. Sin inercia (evita WARN de KDL). -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.30 0.05"/>
      </geometry>
      <material name="base_metal"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.30 0.30 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- CADERA 1: junta en Y (gira la pata) -->
  <joint name="hip_1" type="revolute">
    <parent link="base_link"/>
    <child link="hip1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="2.0"/>
  </joint>
  <link name="hip1">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.18"/>
      </geometry>
      <origin rpy="1.5707 0 0"/>
      <material name="link_blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- MUSLO: junta en X (rodilla superior) -->
  <joint name="hip_2" type="revolute">
    <parent link="hip1"/>
    <child link="thigh"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="2.0"/>
  </joint>
  <link name="thigh">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.30"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
      <material name="link_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.07 0.07 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- CANILLA: junta en X (rodilla) -->
  <joint name="knee" type="revolute">
    <parent link="thigh"/>
    <child link="shank"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="0.0" effort="10" velocity="2.0"/>
  </joint>
  <link name="shank">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
      <material name="link_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- PIE: eslabon fijo al final de la canilla -->
  <joint name="foot_fixed" type="fixed">
    <parent link="shank"/>
    <child link="foot"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>
  <link name="foot">
    <visual>
      <geometry>
        <box size="0.12 0.12 0.04"/>
      </geometry>
      <origin xyz="0 0 0.02"/>
      <material name="foot_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.12 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

</robot>
