<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Orquestador (bringup) que prende todos los nodos para evidenciar la arquitectura.</description>
  <maintainer email="david.collazos_her@uao.edu.co">david</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>robot_interfaces</depend>
  <depend>robot_description</depend>
  <depend>robot_kinematics</depend>
  <depend>robot_control</depend>
  <depend>robot_simulation</depend>
  <depend>robot_teleop</depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
